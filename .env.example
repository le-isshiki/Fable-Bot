# Binance API credentials. Create keys at https://www.binance.com/en/my/settings/api-management
# For the spot testnet, create keys at https://testnet.binance.vision/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Required to be set to "yes" before the bot will place real (non-testnet) orders.
FABLE_BOT_CONFIRM_LIVE=no
